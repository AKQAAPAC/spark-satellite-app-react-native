# Android rain map: Google Maps API key (also written to android/local.properties as MAPS_API_KEY on prebuild).
# GOOGLE_MAPS_API_KEY=

# Optional: force connectivity for testing (good | low | none). Example: CONNECTIVITY_OVERRIDE=low npx expo start
# CONNECTIVITY_OVERRIDE=

# Maps key details: see README.md. Weather uses Open-Meteo (no key).
